{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "conversas": {
      "$usuarioId": {
        ".read": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "chamados": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$usuarioId": {
        ".read": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "usuarios_dados": {
      "$usuarioId": {
        ".read": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $usuarioId",
        "telefone": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    },
    "atendimentos_pendentes": {
      "$usuarioId": {
        ".read": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "controle_ia": {
      "$usuarioId": {
        ".read": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $usuarioId || root.child('admins').child(auth.uid).val() === true)"
      }
    }
  }
}