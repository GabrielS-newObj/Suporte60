<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/initialSplashScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InitialSplashScreen">

    <TextView
        android:id="@+id/textViewInitialSplashScreenMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/support_60"
        android:textColor="#EFFAFCFC"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/imageViewInitialSplashScreenLoading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"
    />

    <ImageView
        android:id="@+id/imageViewInitialSplashScreenLoading"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="65dp"
        android:contentDescription="@string/loading"
        android:src="@drawable/loading"
        app:layout_constraintTop_toBottomOf="@+id/textViewInitialSplashScreenMainTitle"
        app:layout_constraintBottom_toTopOf="@+id/textViewInitialSplashScreenMsg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

    <TextView
        android:id="@+id/textViewInitialSplashScreenMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:gravity="center"
        android:text="@string/loadingInitialMsg"
        android:textColor="#EFFAFCFC"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/imageViewInitialSplashScreenLoading"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

</androidx.constraintlayout.widget.ConstraintLayout>