<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBarAdminChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7AB4AD"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvNomeUsuarioChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="180dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Cliente 1234"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnLigarChat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ligar para o cliente"
                android:src="@android:drawable/ic_menu_call"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminJaAtendido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#FF0000"
                android:contentDescription="Encerrar atendimento e remover da lista"
                android:minHeight="48dp"
                android:minWidth="120dp"
                android:text="Já atendido"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvStatusConexao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFC107"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMensagens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E3F5E0"
        android:padding="8dp"
        android:clipToPadding="false" />

    <RelativeLayout
        android:id="@+id/barraInferiorAdminChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:background="#1B5E20"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/layoutEscrita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etMensagem"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_caixa_textomensag"
                android:hint="Escreva sua resposta..."
                android:paddingHorizontal="16dp" />

            <ImageButton
                android:id="@+id/btnEnviarTexto"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_caixa_textomensag"
                android:contentDescription="Enviar mensagem"
                android:src="@android:drawable/ic_menu_send" />

            <ImageButton
                android:id="@+id/btnMicrofone"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_botao_audio"
                android:contentDescription="Gravar áudio"
                android:src="@android:drawable/ic_btn_speak_now" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutGravando"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_caixa_textoaudio"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnLixeiraAudio"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@null"
                android:contentDescription="Cancelar áudio"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#FF0000" />

            <TextView
                android:id="@+id/tvTempoGravacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnEnviarAudio"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@null"
                android:gravity="center"
                android:src="@android:drawable/ic_menu_send"
                android:textSize="24sp" />
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>