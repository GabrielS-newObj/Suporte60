<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F5E0">

    <FrameLayout
        android:id="@+id/topBarAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#7AB4AD"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Atendimentos"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSair"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Sair"
            android:textColor="#000000"
            android:textSize="16sp" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewChamados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarAdmin"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tvListaVazia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarAdmin"
        android:gravity="center"
        android:text="@string/lista_vazia"
        android:textColor="#616161"
        android:textSize="22sp"
        android:visibility="gone" />
</RelativeLayout>